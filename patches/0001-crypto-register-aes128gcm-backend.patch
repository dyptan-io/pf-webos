+/// Extension point for a platform-specific AES-128-GCM implementation (e.g. hardware
+/// crypto extensions on a target where RustCrypto's own hardware backend doesn't apply).
+/// Call [`register_aes128gcm_backend`] once, before the first [`SessionCrypto`]; without a
+/// call, `SessionCrypto` uses RustCrypto's `aes-gcm`.
+pub trait Aes128GcmBackend: Send + Sync {
+    /// Same contract as `aead::AeadInPlace::encrypt_in_place_detached`.
+    fn seal_in_place(&self, nonce: &[u8; 12], aad: &[u8], buffer: &mut [u8]) -> Result<[u8; 16]>;
+
+    /// Same contract as `aead::AeadInPlace::decrypt_in_place_detached`: on a tag mismatch,
+    /// `buffer` is left unchanged and `Err` is returned.
+    fn open_in_place(&self, nonce: &[u8; 12], aad: &[u8], buffer: &mut [u8], tag: &[u8; 16]) -> Result<()>;
+}
+
+/// Constructor for an [`Aes128GcmBackend`], given the 16-byte session key.
+pub type Aes128GcmCtor = fn(&[u8; 16]) -> Box<dyn Aes128GcmBackend>;
+
+static AES128GCM_BACKEND: OnceLock<Aes128GcmCtor> = OnceLock::new();
+
+/// Register the AES-128-GCM backend every [`SessionCrypto`] constructed afterwards will use.
+/// Must be called before the first `SessionCrypto` with an `Aes128Gcm` key; `Err` if a
+/// backend is already set (by an earlier call, or by the RustCrypto default having already
+/// been lazily installed on a prior `SessionCrypto::new`).
+pub fn register_aes128gcm_backend(ctor: Aes128GcmCtor) -> Result<()> {
+    AES128GCM_BACKEND.set(ctor).map_err(|_| {
+        PunktfunkError::InvalidArg("AES-128-GCM backend already registered or already in use")
+    })
+}
+
+/// Wraps RustCrypto's `aes-gcm`, used whenever [`register_aes128gcm_backend`] is never called.
+struct RustCryptoAes128Gcm(aes_gcm::Aes128Gcm);
+
+impl Aes128GcmBackend for RustCryptoAes128Gcm {
+    fn seal_in_place(&self, nonce: &[u8; 12], aad: &[u8], buffer: &mut [u8]) -> Result<[u8; 16]> {
+        let tag = self
+            .0
+            .encrypt_in_place_detached(Nonce::from_slice(nonce), aad, buffer)
+            .map_err(|_| PunktfunkError::Crypto)?;
+        let mut out = [0u8; TAG_LEN];
+        out.copy_from_slice(&tag);
+        Ok(out)
+    }
+
+    fn open_in_place(
+        &self,
+        nonce: &[u8; 12],
+        aad: &[u8],
+        buffer: &mut [u8],
+        tag: &[u8; 16],
+    ) -> Result<()> {
+        self.0
+            .decrypt_in_place_detached(Nonce::from_slice(nonce), aad, buffer, aes_gcm::Tag::from_slice(tag))
+            .map_err(|_| PunktfunkError::Crypto)
+    }
+}
+
+fn default_aes128gcm_ctor(key: &[u8; 16]) -> Box<dyn Aes128GcmBackend> {
+    Box::new(RustCryptoAes128Gcm(aes_gcm::Aes128Gcm::new(
+        Key::<aes_gcm::Aes128Gcm>::from_slice(key),
+    )))
+}
